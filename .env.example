# Copy to .env and fill in. Variables set in the real environment (e.g. on the hosting platform) win over this file.

# --- LLM backend ------------------------------------------------------------
# auto | openai | api | cli | rules
#   openai: any OpenAI-compatible endpoint (Gemini, Groq, OpenRouter, Mistral, Cerebras, Ollama)
#   api:    Anthropic API (needs ANTHROPIC_API_KEY)
#   cli:    local `claude` CLI signed in with a Claude subscription (development only)
#   rules:  no LLM; decisions by keyword rules, flagged for staff review, no new statistics
GATEKEEPER_LLM=openai

# OpenAI-compatible endpoint. Example: Google Gemini (AI Studio free tier).
GATEKEEPER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GATEKEEPER_LLM_API_KEY=
GATEKEEPER_LLM_MODEL=
# Other free options:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1          (models ending in :free; key from openrouter.ai/keys)
#               Requests are routed only to providers that honour the JSON schema.
#               Free models: about 20 requests/min, and a daily cap that rises once the account holds credits.
#   Ollama      http://localhost:11434/v1             (no key needed)

# Anthropic API (only for GATEKEEPER_LLM=api)
# ANTHROPIC_API_KEY=
# GATEKEEPER_API_MODEL=claude-opus-5-5

# Local Claude CLI model (only for GATEKEEPER_LLM=cli)
# GATEKEEPER_CLI_MODEL=sonnet

# --- Reliability and speed ------------------------------------------------------
# Independent readings per request; the majority wins and waiting stops once a majority agrees.
# Lower to 1 on providers with tight rate limits.
GATEKEEPER_LLM_READINGS=3
# Maximum model calls per minute across the whole app (0 = no limit). Set it just under your provider's
# free-tier limit; calls are spaced evenly and a rate-limited call waits as long as the provider asks.
GATEKEEPER_LLM_MAX_RPM=0
# Seconds to wait for readings before deciding with what has arrived.
GATEKEEPER_LLM_DEADLINE_S=40
# Reasoning effort for Claude backends: low | medium | high | xhigh | max
GATEKEEPER_LLM_EFFORT=low

# --- Paths and server -----------------------------------------------------------
# GATEKEEPER_DATA_DIR=./data
# GATEKEEPER_STATE_DIR=./state
# GATEKEEPER_CACHE_DIR=./.cache/llm
# GATEKEEPER_CORS_ORIGINS=http://localhost:3000
# GATEKEEPER_LOG_LEVEL=INFO
